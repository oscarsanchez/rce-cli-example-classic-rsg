<?xml version="1.0" encoding="utf-8" ?>
<!-- One grid tile: the row's colour and the item's title. -->
<component name="GridItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContent" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/GridItem.brs" />
    <children>
        <Rectangle id="tile" width="336" height="189" />
        <Label id="title" translation="[16,0]" width="304" height="189" horizAlign="center" vertAlign="center" wrap="true" />
    </children>
</component>
